PORT=3000
INTERNAL_PORT=3001
INTERNAL_HOST=127.0.0.1
ADMIN_PORT=3100

# Admin panel authentication and private gateway-to-admin service authentication.
# Use independent random values. Password: 12+ characters. Secrets: 32+ characters.
ADMIN_PASSWORD=replace_with_a_strong_admin_password
ADMIN_SESSION_SECRET=replace_with_at_least_32_random_characters
ADMIN_API_KEY=replace_with_a_different_32_character_secret
GATEWAY_INTERNAL_URL=http://127.0.0.1:3001
PUBLIC_GATEWAY_URL=http://localhost:3000

# Authentication Mode Configuration
# Options: 'api_key' (static secret key) or 'jwt' (HMAC-SHA256 JWT Bearer token)
AUTH_MODE=api_key

# Used when AUTH_MODE=api_key
API_KEY=YOUR_API_KEY_HERE

# Used when AUTH_MODE=jwt (secret key for signing and verifying tokens)
JWT_SECRET=YOUR_JWT_SECRET_HERE

# Configure these in the admin panel or provide deployment-time fallbacks here.
QRIS_STATIC=
GOPAY_MERCHANT_ID=
GOPAY_MASTER_KEY=

# Database Configuration (LibSQL / SQLite / Cloudflare / Turso)
# Local SQLite default: file:data/gateway.db
# In-memory test: file::memory:
# Remote Cloudflare / Turso: libsql://your-db.turso.io
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Default Webhook HMAC-SHA256 Secret Key (Optional: signs all outgoing webhooks unless overridden per-registration)
WEBHOOK_SECRET_KEY=your_webhook_secret_key_here
